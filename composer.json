{
    "name": "undeground20/thesis-amqp-simple-bus",
    "description": "Package for work with producing and consuming amqp messages",
    "license": "MIT",
    "type": "library",
    "version": "0.1",
    "authors": [
        {
            "name": "Nikolay Parshakov",
            "email": "prognik97@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "SimpleBus\\": "src"
        }
    },
    "require": {
        "php": "^8.5",
        "psr/log": "^3.0",
        "ramsey/uuid": "^4.9",
        "thesis/amqp": "^1.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.1",
        "roave/security-advisories": "dev-latest"
    },
    "config": {
        "lock": false,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --colors=always"
    }
}
